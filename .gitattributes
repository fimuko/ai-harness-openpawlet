# =============================================================================
# Git Attributes Configuration
# =============================================================================
# Controls how Git handles line endings and file types across different platforms.
# This ensures consistent behavior on Windows, Linux, and macOS.
# =============================================================================

# Auto-detect text files and normalize line endings to LF in the repository
* text=auto

# =============================================================================
# Shell Scripts - Always use LF (Unix line endings)
# =============================================================================
# Shell scripts must have LF endings or they will fail on Linux/macOS
*.sh text eol=lf

# =============================================================================
# Python Files - Always use LF
# =============================================================================
*.py text eol=lf

# =============================================================================
# Configuration Files - Always use LF
# =============================================================================
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
.env* text eol=lf
Makefile text eol=lf
Containerfile text eol=lf
Dockerfile text eol=lf

# =============================================================================
# Documentation - Always use LF
# =============================================================================
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# =============================================================================
# Web Files - Always use LF
# =============================================================================
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# =============================================================================
# Binary Files - Mark as binary (no line ending conversion)
# =============================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary
*.mp4 binary
*.mov binary
*.avi binary
*.mp3 binary
*.wav binary

# =============================================================================
# Python Binary Files
# =============================================================================
*.pyc binary
*.pyo binary
*.pyd binary
*.so binary
*.dll binary
*.dylib binary
*.whl binary
*.egg binary

# =============================================================================
# ML Model Files - Mark as binary
# =============================================================================
*.pt binary
*.pth binary
*.bin binary
*.onnx binary
*.pb binary
*.h5 binary
*.pkl binary
*.pickle binary
*.safetensors binary

# =============================================================================
# Git LFS (Large File Storage) - if you use it for models
# =============================================================================
# Uncomment these if you want to use Git LFS for model files:
# *.pt filter=lfs diff=lfs merge=lfs -text
# *.pth filter=lfs diff=lfs merge=lfs -text
# *.bin filter=lfs diff=lfs merge=lfs -text
# *.onnx filter=lfs diff=lfs merge=lfs -text
# *.safetensors filter=lfs diff=lfs merge=lfs -text

# =============================================================================
# Windows-specific Files
# =============================================================================
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
