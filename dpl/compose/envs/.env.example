# =============================================================================
# ai-harness-openpawlet — Configuration Template
# =============================================================================
# Copy this file to .env.dev.local (make init-env) and fill in your values.
# Never commit .env.dev.local — it is gitignored.
#
# Usage:
#   make deploy ENV=.env.dev.local
# =============================================================================

# -----------------------------------------------------------------------------
# Container / Stack
# -----------------------------------------------------------------------------
RUNTIME=docker
COMPUTE_TYPE=cpu
STACK_NAME_APPENDIX=

# Pinned upstream version (PyPI)
OPENPAWLET_VERSION=0.4.1

# -----------------------------------------------------------------------------
# Port (agentic range 86xx; ai-harness-nanobot instances use 8610-8619). Console has no
# auth, so it is published on host loopback only.
# -----------------------------------------------------------------------------
PORT=8620

# -----------------------------------------------------------------------------
# Model backend — one provider (OpenPawlet has no presets).
# Rendered into data/openpawlet/config.json at first start; after changing,
# run make reset-config.
#
# OPENPAWLET_PROVIDER: vllm | custom (router) | openrouter | anthropic
# OPENPAWLET_MODEL:    model ID as that provider expects it, e.g.
#                      vllm: default · openrouter: deepseek/deepseek-v4-flash
#                      anthropic: claude-haiku-4-5
# -----------------------------------------------------------------------------
OPENPAWLET_PROVIDER=vllm
OPENPAWLET_MODEL=default

# vllm — ai-llm-inference-service (vLLM behind its gateway, host :8200).
# Its vLLM must run with tool calling and >=16k context, e.g. for Qwen3:
#   VLLM_EXTRA_FLAGS=--enable-auto-tool-choice --tool-call-parser hermes
#   VLLM_MAX_MODEL_LEN=16384
LOCAL_LLM_BASE_URL=http://host.containers.internal:8200/v1
LOCAL_LLM_API_KEY=

# custom — ai-requests-router (LiteLLM, host :8401), virtual key
ROUTER_BASE_URL=http://host.containers.internal:8401/v1
ROUTER_API_KEY=

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Shell exec sandbox: empty (container is the only boundary) or bwrap
# (per-command bubblewrap; adds SYS_ADMIN + unconfined apparmor/seccomp)
# -----------------------------------------------------------------------------
OPENPAWLET_EXEC_SANDBOX=

# -----------------------------------------------------------------------------
# Storage & resources
# -----------------------------------------------------------------------------
HOST_DATA_PATH=../../data
TZ=Europe/Amsterdam
MEMORY_LIMIT=1G
CPU_LIMIT=1.0

# -----------------------------------------------------------------------------
# Build metadata (auto-populated by Makefile)
# -----------------------------------------------------------------------------
BUILD_DATE=
